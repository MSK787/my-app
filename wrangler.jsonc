{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sun-volt-test1",
	"compatibility_date": "2026-08-18",
	"main": "vinext/server/fetch-handler",
	"assets": {
		"directory": "dist/client",
		"not_found_handling": "none",
		"binding": "ASSETS"
	},
	"cache": {
		"enabled": true
	},
	"images": {
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
